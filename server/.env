# CETUD / Dakar Dem Dikk / BRT / TER GTFS-RT Endpoints
# Si tu n'as pas de clé, laisse vide -> mode MOCK Dakar réaliste activé automatiquement

# Endpoint principal CETUD (protobuf)
CETUD_VEHICLE_POSITIONS_URL=https://api.cetud.sn/gtfs-rt/vehiclePositions
CETUD_TRIP_UPDATES_URL=https://api.cetud.sn/gtfs-rt/tripUpdates
CETUD_ALERTS_URL=https://api.cetud.sn/gtfs-rt/alerts

# Clé API CETUD (si nécessaire)
# Certains providers utilisent X-API-Key, Authorization Bearer, ou ?key=
CETUD_API_KEY=
CETUD_API_KEY_HEADER=X-API-Key
# CETUD_API_KEY_HEADER=Authorization
# Pour Bearer, mets "Bearer VOTRE_CLE" dans CETUD_API_KEY

# Autres sources Dakar
DDD_API_URL=https://api.dakardemdikk.sn/gtfs-rt
BRT_API_URL=https://api.sunubrt.sn/gtfs-rt
TER_API_URL=https://api.ter.sn/gtfs-rt

# Mode mock si pas de clé / endpoint injoignable
USE_MOCK=true
MOCK_VEHICLE_COUNT=127

# Server
PORT=8000
NODE_ENV=development
CACHE_TTL_SECONDS=30
POLL_INTERVAL_MS=3000

# CORS
ALLOWED_ORIGINS=http://localhost:8000,https://*.e2b.app,*

# Pour tests avec un vrai feed GTFS-RT public (exemple Suisse, utilise comme fallback)
# Tu peux tester avec un feed public qui ne nécessite pas de clé:
FALLBACK_GTFS_RT_URL=https://api.opentransportdata.swiss/la/gtfs-rt?format=JSON
PORT=8000
