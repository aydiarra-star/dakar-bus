    "gtfs:passbi:check": "node scripts/gtfs/check-passbi-layer.js",
    "gtfs:cetud:check": "node scripts/gtfs/check-cetud-layer.js",
    "gtfs:cetud:install": "node scripts/gtfs/install-cetud-feed.js",
