{
  "name": "dakar-mobilite-pwa",
  "version": "2.2.0",
  "description": "Dakar Mobilité PWA + GTFS-RT CETUD Proxy",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "test-cetud": "node server/test-cetud.js",
    "test": "node --test tests/*.test.js",
    "check:arrets": "node scripts/check-arrets.js",
    "validate:data": "node scripts/check-arrets.js",
    "audit:pages": "node scripts/audit-pages.js",
